familyName = "Redy Serif";
featurePrefixes = (
{
code = "languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn TRK;
languagesystem latn AZE;
languagesystem latn CRT;
languagesystem latn ROM;
";
name = "<anonymous>";
},
{
automatic = 1;
code = "languagesystem DFLT dflt;

languagesystem latn dflt;
languagesystem latn TRK;
languagesystem latn AZE;
languagesystem latn CRT;
languagesystem latn ROM;
";
name = Languagesystems;
}
);
features = (
{
automatic = 1;
code = "feature locl;
feature frac;
feature numr;
feature sups;
";
tag = aalt;
},
{
code = "script latn;
    language TRK exclude_dflt;
    lookup IDOT {
        sub i by idotaccent;
    } IDOT;

    language AZE exclude_dflt;
    lookup IDOT;
    language CRT exclude_dflt;
    lookup IDOT;
    language ROM exclude_dflt;
    lookup SCEDILLA {
        sub scedilla by scommaaccent;
        sub Scedilla by Scommaaccent;
        sub Tcedilla by uni021A;
        sub tcedilla by uni021B;
    } SCEDILLA;
";
tag = locl;
},
{
code = "sub zero slash zero by percent;
    sub one slash two by onehalf;
    sub one slash four by onequarter;
    sub three slash four by threequarters;
    sub three slash five by uni2157;";
tag = frac;
},
{
code = "sub @fig by @sups;";
tag = numr;
},
{
code = "sub @fig by @sups;";
tag = sups;
},
{
automatic = 1;
code = "lookup ccmp_latn_1 {
	lookupflag 0;
	sub fi by f i;
	sub fl by f l;
} ccmp_latn_1;

script latn;
lookup ccmp_latn_1;
";
tag = ccmp;
},
{
automatic = 1;
code = "lookupflag IgnoreMarks;
sub f i by fi;
sub f l by fl;
";
tag = liga;
}
);
