name = "<anonymous>";
}
);
features = (
{
code = "script latn;\012    language TRK exclude_dflt;\012    lookup IDOT {\012        sub i by idotaccent;\012    } IDOT;\012\012    language AZE exclude_dflt;\012    lookup IDOT;\012    language CRT exclude_dflt;\012    lookup IDOT;\012    language ROM exclude_dflt;\012    lookup SCEDILLA {\012        sub scedilla by scommaaccent;\012        sub Scedilla by Scommaaccent;\012        sub Tcedilla by uni021A;\012        sub tcedilla by uni021B;\012    } SCEDILLA;\012";
name = locl;
},
{
